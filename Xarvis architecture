### `backend/src/agents/base.agent.js` — Base Agent
```javascript
// Every agent extends this. Pattern: Strategy + Template Method.
export class BaseAgent {
  constructor(name, model = 'llama3-70b-8192') {
    this.name = name;
    this.model = model;
    this.temperature = 0.7;
    this.maxTokens = 2048;
  }

  // Override in subclasses
  getSystemPrompt(context = {}) {
    throw new Error(`${this.name}: getSystemPrompt() must be implemented`);
  }

  buildMessages(userMessage, history = []) {
    return [
      { role: 'system', content: this.getSystemPrompt() },
      ...history.slice(-10),
      { role: 'user', content: userMessage }
    ];
  }

  async run(userMessage, context = {}, history = []) {
    const messages = this.buildMessages(userMessage, history);
    return await this.callModel(messages, context);
  }

  async callModel(messages, context) {
    // Implemented by AIRouterService — agents don't know which model runs them
    const { aiRouter } = await import('../services/ai/router.service.js');
    return await aiRouter.complete(messages, {
      model: this.model,
      temperature: this.temperature,
      maxTokens: this.maxTokens,
      ...context
    });
  }
}
```

