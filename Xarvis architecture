### `backend/src/services/ai/router.service.js` — AI Model Router
```javascript
// This is your competitive moat. Routes to best model, handles fallbacks.
import Groq from 'groq-sdk';
import Anthropic from '@anthropic-ai/sdk';
import { config } from '../../config/index.js';
import { logger } from '../../utils/logger.js';

class AIRouterService {
  constructor() {
    this.groq = new Groq({ apiKey: config.GROQ_API_KEY });
    this.anthropic = new Anthropic({ apiKey: config.ANTHROPIC_API_KEY });
    this.defaultModel = 'groq'; // Fast + free tier
  }

  async complete(messages, options = {}) {
    const provider = options.provider || this.defaultModel;

    try {
      if (provider === 'groq') return await this._groqComplete(messages, options);
      if (provider === 'anthropic') return await this._anthropicComplete(messages, options);
      throw new Error('Unknown provider');
    } catch (err) {
      logger.warn(`Primary AI (${provider}) failed: ${err.message}. Falling back.`);
      return await this._fallback(messages, options);
    }
  }

  async _groqComplete(messages, options) {
    const res = await this.groq.chat.completions.create({
      model: options.model || 'llama3-70b-8192',
      messages,
      temperature: options.temperature || 0.7,
      max_tokens: options.maxTokens || 2048,
    });
    return res.choices[0].message.content;
  }

  async _anthropicComplete(messages, options) {
    const system = messages.find(m => m.role === 'system')?.content || '';
    const userMessages = messages.filter(m => m.role !== 'system');
    const res = await this.anthropic.messages.create({
      model: 'claude-sonnet-4-20250514',
      max_tokens: options.maxTokens || 2048,
      system,
      messages: userMessages,
    });
    return res.content[0].text;
  }

  async _fallback(messages, options) {
    // Try Anthropic if Groq fails, and vice versa
    try {
      const fallbackProvider = options.provider === 'groq' ? 'anthropic' : 'groq';
      return await this.complete(messages, { ...options, provider: fallbackProvider });
    } catch (err) {
      logger.error('All AI providers failed:', err.message);
      throw new Error('AI service temporarily unavailable. Please try again.');
    }
  }
}

export const aiRouter = new AIRouterService();
```

